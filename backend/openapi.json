{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "App"
        ]
      }
    },
    "/cities": {
      "get": {
        "description": "Returns a paginated list of cities",
        "operationId": "getAllCities",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number (1-based)",
            "schema": {
              "minimum": 1,
              "default": 1,
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Items per page",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "example": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of cities retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CitiesApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters"
          },
          "500": {
            "description": "An error occurred while retrieving cities"
          }
        },
        "summary": "Get all cities",
        "tags": [
          "cities"
        ]
      }
    }
  },
  "info": {
    "title": "Cities Management API",
    "description": "API for managing cities",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "City": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Berlin",
            "description": "The name of the city"
          },
          "name_native": {
            "type": "string",
            "example": "Berlin",
            "description": "The native name of the city"
          },
          "country": {
            "type": "string",
            "example": "Germany",
            "description": "The country where the city is located"
          },
          "continent": {
            "type": "string",
            "example": "Europe",
            "description": "The continent where the city is located"
          },
          "latitude": {
            "type": "number",
            "example": 52.52,
            "description": "The latitude of the city"
          },
          "longitude": {
            "type": "number",
            "example": 13.405,
            "description": "The longitude of the city"
          },
          "population": {
            "type": "number",
            "example": 3669491,
            "description": "The population of the city"
          },
          "founded": {
            "type": "number",
            "example": 1237,
            "description": "The year the city was founded"
          },
          "landmarks": {
            "example": [
              "Brandenburg Gate",
              "Berlin Wall"
            ],
            "description": "Famous landmarks in the city",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "name_native",
          "country",
          "continent",
          "latitude",
          "longitude",
          "population",
          "founded",
          "landmarks"
        ]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "example": 1,
            "description": "Current page (1-based)"
          },
          "limit": {
            "type": "number",
            "example": 10,
            "description": "Number of items per page"
          },
          "totalPages": {
            "type": "number",
            "example": 5,
            "description": "Total number of pages"
          },
          "totalItems": {
            "type": "number",
            "example": 42,
            "description": "Total number of items"
          }
        },
        "required": [
          "page",
          "limit",
          "totalPages",
          "totalItems"
        ]
      },
      "CitiesResponseData": {
        "type": "object",
        "properties": {
          "items": {
            "description": "Cities for the current page",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/City"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        },
        "required": [
          "items",
          "pagination"
        ]
      },
      "CitiesApiResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/CitiesResponseData"
              }
            ]
          },
          "error": {
            "type": "object",
            "nullable": true
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Cities retrieved successfully"
          }
        },
        "required": [
          "success",
          "data",
          "message"
        ]
      }
    }
  }
}